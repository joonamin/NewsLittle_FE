{
  "name": "newslittle-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:browser:install": "playwright install chromium",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest --project storybook",
    "test:e2e": "npm run build && playwright test tests/e2e/routes.spec.ts",
    "test:e2e:mocks": "NEXT_PUBLIC_API_BASE_URL= NEXT_PUBLIC_API_MOCKING=enabled npm run build && playwright test tests/e2e/mock-api.spec.ts",
    "test": "npm run test:unit && npm run test:storybook && npm run test:e2e && npm run test:e2e:mocks"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "msw": "2.15.0",
    "playwright": "1.61.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  }
}
