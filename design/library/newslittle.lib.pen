            {
              "type": "frame",
              "id": "mUooe",
              "name": "상태 화면 예시",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "type": "frame",
                  "id": "P2Pzg",
                  "name": "State / Loading · 로딩 중",
                  "context": "state:loading — 데이터를 불러오는 중임을 알리는 전체 화면 상태. 스피너와 안내 문구로 사용자가 기다려야 함을 인지시킨다.\n@viewmodel {\"model\":\"LoadingStateVM\",\"fields\":[{\"name\":\"title\",\"type\":\"string\",\"bind\":\"mIN5K.content\",\"required\":true},{\"name\":\"description\",\"type\":\"string\",\"bind\":\"O3LDeH.content\"}]}",
                  "reusable": true,
                  "width": "fill_container",
                  "height": 320,
                  "fill": "$nl-subtle",
                  "cornerRadius": 12,
                  "layout": "vertical",
                  "gap": 16,
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "zK2HK",
                      "name": "Spinner / 로딩 스피너",
                      "context": "spinner — 처리가 진행 중임을 나타내는 회전 인디케이터. 로딩 상태 화면이나 버튼 내부 등 대기 상태를 표현해야 하는 곳에 재사용한다.\n@viewmodel {\"model\":\"SpinnerVM\",\"fields\":[]}",
                      "reusable": true,
                      "width": 40,
                      "height": 40,
                      "layout": "none",
                      "children": [
                        {
                          "type": "ellipse",
                          "id": "J3euD",
                          "x": 0,
                          "y": 0,
                          "name": "스피너 트랙",
                          "innerRadius": 0.82,
                          "fill": "$nl-border",
                          "width": 40,
                          "height": 40
                        },
                        {
                          "type": "ellipse",
                          "id": "mFw4C",
                          "x": 0,
