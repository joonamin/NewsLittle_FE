                  "type": "frame",
                  "id": "Rd5Tc",
                  "name": "Button",
                  "context": "button — 모든 액션 버튼의 단일 마스터. btn-variant(primary/secondary/default) · btn-size(l/m/s) · btn-state(enabled/disabled) 속성으로 파생한다.\n@viewmodel {\"model\":\"ButtonVM\",\"fields\":[{\"name\":\"label\",\"type\":\"string\",\"bind\":\"yZaSP.content\",\"required\":true},{\"name\":\"variant\",\"type\":\"'primary'|'secondary'|'default'\",\"bind\":\"theme:btn-variant\",\"default\":\"primary\"},{\"name\":\"size\",\"type\":\"'l'|'m'|'s'|'xs'\",\"bind\":\"theme:btn-size\",\"default\":\"l\"},{\"name\":\"disabled\",\"type\":\"boolean\",\"bind\":\"theme:btn-state\"}],\"actions\":[{\"name\":\"onPress\",\"bind\":\"self\"}]}",
                  "theme": {
                    "btn-variant": "primary",
                    "btn-size": "l",
                    "btn-state": "enabled"
                  },
                  "reusable": true,
                  "fill": "$nl-btn-fill",
                  "cornerRadius": 8,
                  "stroke": "$nl-btn-stroke",
                  "strokeWidth": "$nl-btn-stroke-width",
