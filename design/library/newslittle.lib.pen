                          "innerRadius": 0.82,
                          "startAngle": 30,
                          "sweepAngle": 100,
                          "fill": "$nl-accent",
                          "width": 40,
                          "height": 40
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "mIN5K",
                      "name": "로딩 제목",
                      "fill": "$nl-text",
                      "content": "불러오는 중이에요",
                      "fontFamily": "$nl-font",
                      "fontSize": 20,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "O3LDeH",
                      "name": "로딩 설명",
                      "fill": "$nl-muted",
                      "content": "잠시만 기다려 주세요.",
                      "fontFamily": "$nl-font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "MTQm0",
                  "name": "State / Error · 오류 발생 화면",
                  "context": "state:error — 요청 실패·오류 발생 시 보여주는 전체 화면 상태. 오류 메시지와 재시도 행동을 제공해 사용자가 다음 행동을 취하게 안내한다.\n@viewmodel {\"model\":\"ErrorStateVM\",\"fields\":[{\"name\":\"title\",\"type\":\"string\",\"bind\":\"DxYnj.content\",\"required\":true},{\"name\":\"description\",\"type\":\"string\",\"bind\":\"PaN13.content\",\"required\":true}],\"actions\":[{\"name\":\"onRetry\",\"bind\":\"BY827\"},{\"name\":\"onGoHome\",\"bind\":\"mp041\"}]}",
                  "reusable": true,
                  "width": "fill_container",
                  "height": 320,
                  "fill": "$nl-subtle",
                  "cornerRadius": 12,
                  "layout": "vertical",
                  "gap": 16,
                  "padding": 32,
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "iKbbh",
                      "name": "오류 안내 아이콘",
                      "width": 40,
                      "height": 40,
                      "icon": "circle-alert",
                      "library": "lucide",
                      "fill": "$nl-negative"
                    },
                    {
                      "type": "text",
                      "id": "DxYnj",
