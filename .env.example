# Public backend API URL. Do not place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=

# Absolute backend URL used only for server-side prefetching (SSR). Optional:
# falls back to NEXT_PUBLIC_API_BASE_URL. When both are empty the home page
# skips its SSR prefetch and fetches on the client instead.
API_BASE_URL=

# Set to enabled only for local mock development. Keep the API base URL empty.
NEXT_PUBLIC_API_MOCKING=disabled

# Google OAuth 2.0 Client ID used by Google Identity Services in the browser.
# Must match the same client configured as NEWSLITTLE_GOOGLE_CLIENT_ID on the backend.
# Leave empty while NEXT_PUBLIC_API_MOCKING=enabled; the login button falls back to a mock credential.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
